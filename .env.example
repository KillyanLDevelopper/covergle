# =============================================================
# lebegue / covergle — Variables d'environnement
# Copier ce fichier : cp .env.example .env
# Remplir toutes les valeurs avant de lancer les containers
# =============================================================

# --- Twitch / IGDB API ---
# Créer une application sur : https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx     # CHANGEZ CETTE VALEUR EN PROD
TWITCH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx # CHANGEZ CETTE VALEUR EN PROD

# --- CORS ---
# Domaine principal de l'application (aucun autre domaine ne pourra appeler l'API)
ALLOWED_ORIGIN=https://covergle.fr

# --- Bot Discord ---
# Créer un bot sur : https://discord.com/developers/applications
DISCORD_BOT_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
DISCORD_CHANNEL_ID=xxxxxxxxxxxxxxxxxxxx
